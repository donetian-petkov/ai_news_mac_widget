generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppState {
  id        Int      @id
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiUsageSnapshot {
  id           Int      @id @default(autoincrement())
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  createdAt    DateTime @default(now())
}

model NewsItemRecord {
  key                String   @id
  feedUrl            String
  itemId             String
  title              String
  titleBg            String?
  titleEn            String?
  neutralTitle       String?
  neutralTitleBg     String?
  neutralTitleEn     String?
  neutralTitleStatus String?
  neutralTitleReason String?
  neutralTitleClassification String?
  neutralTitleConfidence Float?
  neutralTitleCheckedAtMs BigInt?
  coverUrl           String?
  link               String
  source             String
  published          String?
  publishedMs        BigInt
  isMatch            Boolean
  matchScore         Float
  filteredOk         Boolean
  summary            String?
  research           String?
  insightStatus      String?
  insightsJson       String?
  topicHitsJson      String?
  emergingSignalJson String?
  mood               String?
  newsType           String?
  contextText        String?
  linkText           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([feedUrl, itemId])
  @@index([feedUrl, publishedMs, itemId])
  @@index([publishedMs, itemId])
}

model User {
  id           Int               @id @default(autoincrement())
  username     String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  providerKeys UserProviderKey[]
  settings     UserSettings?
  featureRecords UserFeatureRecord[]
  shareLinks   ShareLink[]
}

model UserProviderKey {
  id           Int      @id @default(autoincrement())
  userId       Int
  provider     String
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model UserSettings {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  settingsJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ErrorLogRecord {
  id              Int      @id @default(autoincrement())
  category        String
  feedUrl         String?
  feedLabel       String?
  attempt         Int?
  maxAttempts     Int?
  failCount       Int?
  disabledUntilMs BigInt?
  message         String
  detailsJson     String?
  createdAt       DateTime @default(now())

  @@index([category, createdAt])
  @@index([feedUrl, createdAt])
}

model UserFeatureRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  kind        String
  title       String
  payloadJson String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, updatedAt])
  @@index([kind, updatedAt])
}

model DeliveryHistoryRecord {
  id          Int      @id @default(autoincrement())
  userId      Int?
  feedUrl     String?
  itemId      String?
  title       String?
  source      String?
  stage       String
  status      String
  reason      String?
  detailsJson String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feedUrl, createdAt])
  @@index([stage, status, createdAt])
}

model ShareLink {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  userId      Int
  kind        String
  title       String
  payloadJson String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}
